{
	"name": "@galeedgutierrez/frontend-config",
	"version": "0.1.0",
	"description": "Shared front-end configs (stylelint, Prettier, commitlint, PostCSS, UnoCSS, markdownlint, textlint, Lighthouse CI, lint-staged) and an Astro integration with the post-build CSS, font and CSP steps.",
	"keywords": [
		"astro",
		"astro-integration",
		"stylelint-config",
		"prettier-config",
		"commitlint-config",
		"unocss",
		"postcss",
		"purgecss",
		"lightningcss",
		"csp"
	],
	"homepage": "https://github.com/GaleedGutierrez/frontend-config/tree/main/packages/frontend-config#readme",
	"bugs": {
		"url": "https://github.com/GaleedGutierrez/frontend-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GaleedGutierrez/frontend-config.git",
		"directory": "packages/frontend-config"
	},
	"license": "MIT",
	"author": "Galeed Gutierrez <galeedeveloper@gmail.com> (https://galeedgutierrez.com/)",
	"type": "module",
	"exports": {
		"./astro": {
			"types": "./dist/astro.d.ts",
			"default": "./dist/astro.js"
		},
		"./steps": {
			"types": "./dist/steps/index.d.ts",
			"default": "./dist/steps/index.js"
		},
		"./commitlint": {
			"types": "./dist/commitlint.d.ts",
			"default": "./dist/commitlint.js"
		},
		"./git": {
			"types": "./dist/git.d.ts",
			"default": "./dist/git.js"
		},
		"./lighthouse": {
			"types": "./dist/lighthouse.d.ts",
			"default": "./dist/lighthouse.js"
		},
		"./lint-staged": {
			"types": "./dist/lintStaged.d.ts",
			"default": "./dist/lintStaged.js"
		},
		"./markdownlint": {
			"types": "./dist/markdownlint.d.ts",
			"default": "./dist/markdownlint.js"
		},
		"./postcss": {
			"types": "./dist/postcss.d.ts",
			"default": "./dist/postcss.js"
		},
		"./prettier": {
			"types": "./dist/prettier.d.ts",
			"default": "./dist/prettier.js"
		},
		"./stylelint": {
			"types": "./dist/stylelint.d.ts",
			"default": "./dist/stylelint.js"
		},
		"./textlint": {
			"types": "./dist/textlint.d.ts",
			"default": "./dist/textlint.js"
		},
		"./unocss": {
			"types": "./dist/unocss.d.ts",
			"default": "./dist/unocss.js"
		}
	},
	"bin": {
		"galeed-git-history": "./dist/bin/gitHistory.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-package": "publint --strict && attw --pack --profile esm-only"
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2.4",
		"browserslist": "^4.29.6",
		"cssnano": "^9.9.0",
		"lightningcss": "^1.30.1",
		"postcss": "^8.5.6",
		"postcss-custom-properties": "^15.0.5",
		"postcss-mixins": "^12.1.2",
		"postcss-utopia": "^1.1.0",
		"prettier-plugin-astro": "1.1.2",
		"purgecss": "^9.1.0",
		"stylelint-config-standard": "^41.0.0",
		"stylelint-order": "^8.1.3",
		"subset-font": "^2.9.0",
		"textlint-filter-rule-comments": "^1.3.0",
		"textlint-rule-terminology": "^5.2.16"
	},
	"devDependencies": {
		"@commitlint/types": "^21.2.3"
	},
	"peerDependencies": {
		"astro": ">=7",
		"prettier": ">=3.10",
		"stylelint": ">=18",
		"unocss": ">=66"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"prettier": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		},
		"unocss": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
