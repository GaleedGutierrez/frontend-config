{
	"extends": "./packages/tsconfig/base.json",
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["**/*"],
	"exclude": ["**/dist", "node_modules"]
}
